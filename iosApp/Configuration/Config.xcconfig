// Shared by Dev.xcconfig, QA.xcconfig and Prod.xcconfig. Do not set FITAI_ENVIRONMENT here.
// Android reads MARKETING_VERSION and CURRENT_PROJECT_VERSION from this file.

DEVELOPMENT_TEAM=VJ46P5P6NP
CODE_SIGN_STYLE=Automatic

// Firebase GoogleService-Info.plist BUNDLE_ID and the Android applicationId.
PRODUCT_BUNDLE_IDENTIFIER=com.fitai.app
PRODUCT_NAME=FitAI

// SemVer, user-facing (CFBundleShortVersionString). Feature → minor, fix → patch.
MARKETING_VERSION=1.0.0
// Integer build (CFBundleVersion). +1 for every TestFlight or App Store upload.
CURRENT_PROJECT_VERSION=1
