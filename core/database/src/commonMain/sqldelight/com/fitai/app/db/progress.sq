CREATE TABLE body_measurements (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    weight_kg REAL NOT NULL,
    body_fat_pct REAL,
    chest_cm REAL,
    waist_cm REAL,
    hip_cm REAL,
    arm_cm REAL,
    photo_url TEXT,
    measured_at TEXT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

CREATE INDEX idx_body_measurements_user_measured
ON body_measurements(user_id, measured_at DESC);

selectMeasurementsForUser:
SELECT * FROM body_measurements WHERE user_id = ? ORDER BY measured_at DESC;

selectMeasurementById:
SELECT * FROM body_measurements WHERE id = ?;

selectLatestMeasurementForUser:
SELECT * FROM body_measurements WHERE user_id = ? ORDER BY measured_at DESC LIMIT 1;

selectMeasurementsForUserInRange:
SELECT * FROM body_measurements
WHERE user_id = ? AND measured_at >= ? AND measured_at < ?
ORDER BY measured_at DESC;

insertMeasurement:
INSERT INTO body_measurements (
    id,
    user_id,
    weight_kg,
    body_fat_pct,
    chest_cm,
    waist_cm,
    hip_cm,
    arm_cm,
    photo_url,
    measured_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMeasurement:
UPDATE body_measurements
SET
    weight_kg = ?,
    body_fat_pct = ?,
    chest_cm = ?,
    waist_cm = ?,
    hip_cm = ?,
    arm_cm = ?,
    photo_url = ?,
    measured_at = ?
WHERE id = ?;

deleteMeasurement:
DELETE FROM body_measurements WHERE id = ?;

deleteMeasurementsForUser:
DELETE FROM body_measurements WHERE user_id = ?;
